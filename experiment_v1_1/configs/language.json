  "split_roles": {
    "train": [
      "LM fitting",
      "dictionary fitting",
      "probe fitting and ANOVA ranking",
      "preprocessing statistics"
    ],
    "validation": [
      "LM checkpoint and gate decisions",
      "dictionary checkpoint selection",
      "probe regularization, feature-count and threshold selection",
      "causal matching-bin definition and implementation checks"
    ],
    "test": [
      "one-time final behavior, semantic, fidelity and causal reporting"
    ]
  },
  "selection_guards": {
    "test_used_for_selection": false,
    "interpretation_sequence_stays_within_one_split": true,
